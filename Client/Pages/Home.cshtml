@page
@model HomeModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-4">
    <h1 class="display-4">Identity</h1>
    <p class="text-muted">Choose a section to manage.</p>
</div>

<div class="row justify-content-center g-3">
    @if (User.IsInRole("Admin") || User.IsInRole("Operator"))
    {
        <div class="col-md-4">
            <a asp-page="/ClientApps" class="btn btn-outline-primary w-100 py-4">Client Apps</a>
        </div>
        <div class="col-md-4">
            <button type="button" class="btn btn-outline-secondary w-100 py-4" disabled title="Not implemented yet">Users</button>
        </div>
    }
</div>
